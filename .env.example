# Oura Health Agent Configuration
# Copy this file to .env and fill in your credentials
# Or run: python scripts/setup.py

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override. The application defaults to claude-opus-4-8.
# Leave this unset unless you have verified access, eligibility, and retention.
# ANTHROPIC_MODEL=claude-opus-4-8
#
# Fable 5 requires mandatory 30-day provider retention and can refuse some
# health/biology requests; the shared model helper falls back to Opus 4.8.
# ANTHROPIC_MODEL=claude-fable-5

# Existing Oura credential used by the current implementation.
# Oura has deprecated personal access tokens and recommends OAuth2 + webhooks.
# OAuth is not implemented yet, so new installations without an existing
# working token are not currently supported by the setup wizard.
OURA_ACCESS_TOKEN=...

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNO...

# Telegram Chat ID (your personal chat ID with the bot)
TELEGRAM_CHAT_ID=123456789

# Telegram Webhook Secret (auto-generated by setup wizard)
TELEGRAM_WEBHOOK_SECRET=...
